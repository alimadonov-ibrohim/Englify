# ============================================
#  Englify AI backend — muhit sozlamalari
#  Bu faylni ".env" deb nusxalab, kalitni yozing.
#  .env faylni hech kimga yubormang / GitHubga qo'ymang.
# ============================================

# Qaysi provayder: openai | gemini | mock
# Bo'sh qoldirsangiz, mavjud kalitga qarab avtomatik tanlanadi.
AI_PROVIDER=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Asosiy model band yoki kvota tugasa, shu modelga avtomatik o'tadi.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# AI maslahat kabi interaktiv bo'limlar uchun tez modellar.
# Asosiy model band/kvotasi tugagan bo'lsa ham ular ishlaydi.
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_FAST_FALLBACK_MODEL=gemini-3.5-flash-lite
# 0 = thinking o'chirilgan (JSON javob tezroq va to'liq qaytadi).
GEMINI_THINKING_BUDGET=0

# --- Server ---
PORT=8000
HOST=127.0.0.1

# --- Auth / foydalanuvchilar bazasi ---
# Admin huquqiga ega emaillar (vergul bilan ajratiladi).
ADMIN_EMAILS=alimardonovio11@gmail.com,admin@englify.uz
# Token imzosi uchun maxfiy kalit. Bo'sh bo'lsa avtomatik yaratiladi.
# Productionda albatta o'zingizning uzun tasodifiy qiymatingizni yozing.
AUTH_SECRET=

# Doimiy umumiy baza (ixtiyoriy; Vercel uchun tavsiya etiladi).
# Upstash Redis REST:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Yoki Vercel KV nomlari:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# CORS: sayt qaysi manzildan ochilsa, o'sha origin ruxsat etiladi.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8138,http://127.0.0.1:8138,http://localhost:5500,http://127.0.0.1:5500

# file:// orqali ochishga ruxsat berish (xavfsizlik uchun 0 tavsiya etiladi)
ALLOW_FILE_ORIGIN=0

# --- Google bilan kirish (haqiqiy OAuth) ---
# 1) https://console.cloud.google.com/apis/credentials
# 2) "Create credentials" → "OAuth client ID" → Application type: Web application
# 3) Authorized JavaScript origins ga quyidagilarni qo'shing:
#      http://localhost:8000
#      http://127.0.0.1:8000
#      https://englify-eta.vercel.app   (yoki o'z domeningiz)
# 4) Olingan Client ID ni shu yerga yozing.
GOOGLE_CLIENT_ID=
# Bir nechta Client ID (vergul bilan): GOOGLE_CLIENT_IDS=id1.apps.googleusercontent.com,id2.apps.googleusercontent.com

