# ============================================
#  Englify AI backend — muhit sozlamalari
#  Bu faylni ".env" deb nusxalab, kalitni yozing.
#  .env faylni hech kimga yubormang / GitHubga qo'ymang.
# ============================================

# Qaysi provayder: openai | gemini | mock
# Bo'sh qoldirsangiz, mavjud kalitga qarab avtomatik tanlanadi.
AI_PROVIDER=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Asosiy model band yoki kvota tugasa, shu modelga avtomatik o'tadi.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# 0 = thinking o'chirilgan (JSON javob tezroq va to'liq qaytadi).
GEMINI_THINKING_BUDGET=0

# --- Server ---
PORT=8000
HOST=127.0.0.1

# CORS: sayt qaysi manzildan ochilsa, o'sha origin ruxsat etiladi.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8138,http://127.0.0.1:8138,http://localhost:5500,http://127.0.0.1:5500

# file:// orqali ochishga ruxsat berish (xavfsizlik uchun 0 tavsiya etiladi)
ALLOW_FILE_ORIGIN=0
